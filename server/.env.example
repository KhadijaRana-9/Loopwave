# Copy to .env and fill in real values. Never commit .env.
#
# Production requirement summary:
#   REQUIRED for basic production   -> Core, Database, Auth
#   REQUIRED for real AI            -> AI_PROVIDER=openai + OPENAI_API_KEY
#   REQUIRED for real WhatsApp      -> WHATSAPP_ACCESS_TOKEN, WHATSAPP_BUSINESS_ACCOUNT_ID,
#                                      WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_SECRET
#   REQUIRED for a durable queue    -> REDIS_URL (a real hosted Redis, not localhost)
#   OPTIONAL                        -> Payments, Email, Object storage
# Without the "required for X" sections, that feature runs its existing,
# honestly-labeled demo/sandbox path instead of failing — see
# src/config/env.ts#integrationReadiness.

# --- Core (REQUIRED) ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_APP_URL=http://localhost:5173

# --- Database (PostgreSQL) (REQUIRED) ---
# Local: postgresql://user:password@localhost:5432/loopwave
# Or a free-tier hosted instance (Neon, Supabase, Railway, RDS, etc.)
# IMPORTANT: if this endpoint goes through PgBouncer/connection pooling in
# transaction mode (Neon's default "-pooler" endpoint, Supabase's pooler,
# RDS Proxy in transaction mode, etc.), append &pgbouncer=true. Without it,
# Prisma's prepared-statement caching can misfire under concurrent requests —
# queries silently return stale or wrong results (observed here as spurious
# foreign-key violations under test-suite load). Not needed for a direct,
# unpooled Postgres connection.
DATABASE_URL=postgresql://user:password@localhost:5432/loopwave
# Prisma's schema.prisma references DIRECT_URL directly, so it must always be
# set to *some* valid postgresql:// URL or `prisma migrate`/`generate` will
# fail to resolve it. On plain local/RDS Postgres, just repeat DATABASE_URL's
# value here. On Neon specifically: DATABASE_URL is the pooled (-pooler)
# endpoint for the app at runtime; DIRECT_URL is the same connection without
# "-pooler" in the host, used only by `prisma migrate` (pgbouncer's
# transaction pooling can't hold the advisory lock migrations need).
DIRECT_URL=postgresql://user:password@localhost:5432/loopwave

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-me-64-char-hex
JWT_REFRESH_SECRET=replace-me-different-64-char-hex
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost

# --- Redis (background jobs, BullMQ) ---
REDIS_URL=redis://localhost:6379

# --- WhatsApp Cloud API (Meta) ---
# Leave unset to run WhatsApp integration in demo/sandbox mode.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0

# --- AI provider (abstracted — see src/services/ai/) ---
AI_PROVIDER=demo
OPENAI_API_KEY=

# --- Payments (Stripe is the fully-implemented provider — see server/src/integrations/payments.adapter.ts) ---
STRIPE_SECRET_KEY=
# From the Stripe Dashboard webhook endpoint you point at {APP_URL}/api/billing/webhook.
# Subscribe it to: checkout.session.completed, invoice.paid, invoice.payment_failed,
# customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=
# Razorpay env vars are read (see integrationReadiness in src/config/env.ts) but
# checkout/webhook handling for Razorpay is not implemented — Stripe is the
# complete path. Leave these unset unless you're adding that integration.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Email ---
EMAIL_PROVIDER=demo
RESEND_API_KEY=
EMAIL_FROM=Loopwave <notifications@loopwave.demo>

# --- Object storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- Field-level encryption for stored integration/WhatsApp secrets ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-me-32-byte-hex
