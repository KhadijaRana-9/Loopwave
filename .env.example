# Copy to .env and adjust if your backend isn't running on the default port.
# Never commit .env.

# Base URL of the Loopwave API (see server/.env.example for the backend).
# REQUIRED for production: point this at the deployed backend's /api path
# (e.g. https://loopwave-api.up.railway.app/api) — never a localhost URL.
VITE_API_URL=http://localhost:4000/api
